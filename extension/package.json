{
  "name": "workspace-code-review",
  "displayName": "Workspace Code Review",
  "description": "Local code review with MCP server support for AI assistants",
  "version": "0.1.0",
  "publisher": "PierreGauthier",
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreGauthier/vscode-local-code-review"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localCodeReview",
          "title": "Code Review",
          "icon": "./resources/icon.svg"
        }
      ]
    },
    "views": {
      "localCodeReview": [
        {
          "id": "localCodeReview.filesView",
          "name": "Files to Review"
        }
      ]
    },
    "commands": [
      {
        "command": "localCodeReview.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.openDiff",
        "title": "Open Diff",
        "icon": "$(diff)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.validateFile",
        "title": "Validate File",
        "icon": "$(pass-filled)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.addComment",
        "title": "Add Comment",
        "icon": "$(comment-add)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.resolveComment",
        "title": "Resolve Comment",
        "icon": "$(check)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.submitComment",
        "title": "Submit",
        "category": "Code Review",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "localCodeReview.nextFile",
        "title": "Next File",
        "icon": "$(arrow-right)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.devalidateFile",
        "title": "Reopen for review",
        "icon": "$(pass)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.discardChanges",
        "title": "Discard Changes",
        "icon": "$(discard)",
        "category": "Code Review"
      },
      {
        "command": "localCodeReview.resetValidation",
        "title": "Reset Validation",
        "icon": "$(sync-ignored)",
        "category": "Code Review"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localCodeReview.refresh",
          "when": "view == localCodeReview.filesView",
          "group": "navigation@1"
        },
        {
          "command": "localCodeReview.resetValidation",
          "when": "view == localCodeReview.filesView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "localCodeReview.validateFile",
          "when": "view == localCodeReview.filesView && viewItem == file_to_review",
          "group": "inline@1"
        },
        {
          "command": "localCodeReview.devalidateFile",
          "when": "view == localCodeReview.filesView && viewItem == file_validated",
          "group": "inline@1"
        },
        {
          "command": "localCodeReview.addComment",
          "when": "view == localCodeReview.filesView && viewItem =~ /^file_/",
          "group": "1_actions@1"
        },
        {
          "command": "localCodeReview.resolveComment",
          "when": "view == localCodeReview.filesView && viewItem =~ /^file_/",
          "group": "1_actions@2"
        },
        {
          "command": "localCodeReview.discardChanges",
          "when": "view == localCodeReview.filesView && viewItem =~ /^file_/",
          "group": "2_danger@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "localCodeReview.resolveComment",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "localCodeReview.validateFile",
          "group": "navigation@1",
          "when": "localCodeReview.fileInReview"
        },
        {
          "command": "localCodeReview.nextFile",
          "group": "navigation@2",
          "when": "localCodeReview.fileInReview"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localCodeReview.submitComment",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "key": "escape",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "commentEditorFocused"
      }
    ],
    "configuration": {
      "title": "Local Code Review",
      "properties": {
        "localCodeReview.defaultSource": {
          "type": "string",
          "enum": ["working_diff", "last_commit"],
          "enumDescriptions": [
            "All modified files (staged + unstaged) since the last commit",
            "Only files from the last git commit"
          ],
          "default": "working_diff",
          "description": "Diff source when starting a review"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
